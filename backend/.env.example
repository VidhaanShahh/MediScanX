# ── MediScanX — Environment Variables ──────────────────────────
# Copy this file to .env and fill in real values.

DATABASE_URL=postgresql+psycopg2://mediscanx:mediscanx_password@localhost:5432/mediscanx
SECRET_KEY=CHANGE-ME-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
DEBUG=false
